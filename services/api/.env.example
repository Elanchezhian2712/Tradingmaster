ENVIRONMENT=development

# Ports are offset from Postgres/Redis defaults (5433/6380 instead of 5432/6379)
# to avoid clashing with a Postgres/Redis already installed on the dev machine.
# Adjust to 5432/6379 if nothing else is using them, and update docker-compose.yml
# to match.
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5433/trading_master
REDIS_URL=redis://localhost:6380/0

# Generate a real secret for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-.env-never-commit-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173"]

RATE_LIMIT_PER_MINUTE=120
